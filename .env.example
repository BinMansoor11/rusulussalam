# Copy to .env.local for local development. See README.md for local URLs.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional local legacy anonymous fallback. Staging uses a publishable key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
AUTH_SITE_URL=
# Required only for the staging build check.
STAGING_SUPABASE_PROJECT_REF=
# Staging Vercel setting. The local app does not read it.
ENABLE_EXPERIMENTAL_COREPACK=
